# OpenCode Server URL (the runner starts it automatically by default)
# OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Per-stage model overrides (otherwise config/stages.yaml wins)
# HARNESS_MODEL_HUNT=deepseek/deepseek-v4-flash
# HARNESS_MODEL_VALIDATE=deepseek/deepseek-v4-pro

# OpenCode handles its own auth via opencode.json or /connect
# See: https://opencode.ai/docs/providers
